{
  "name": "@therapy-docs/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "pubsub:setup": "dotenv -e ../../.env -- tsx src/scripts/setup-pubsub.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.1",
    "@google-cloud/secret-manager": "^6.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@therapy-docs/audit": "workspace:*",
    "@therapy-docs/db": "workspace:*",
    "@therapy-docs/llm-client": "workspace:*",
    "@therapy-docs/shared-types": "workspace:*",
    "@therapy-docs/storage": "workspace:*",
    "@trpc/server": "^10.45.2",
    "googleapis": "^166.0.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@therapy-docs/config": "workspace:*",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "webpack": "^5.109.1",
    "webpack-node-externals": "^3.0.0"
  }
}
