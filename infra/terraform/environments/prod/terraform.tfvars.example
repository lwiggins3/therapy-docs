project_id       = "therapy-docs-prod"
region           = "us-central1"
workspace_domain = "example-clinic.com"

# See environments/dev/terraform.tfvars.example's comment — same pattern, this environment's own
# OAuth client (prod is typically a separate GCP project from dev, so a separate OAuth client too).
# Note: web's URL, not api's — Google's redirect is browser-mediated, so it must land on web's
# IAP-authenticated origin, which then proxies it to api server-side.
gmail_oauth_client_id     = "your-client-id.apps.googleusercontent.com"
gmail_oauth_client_secret = "your-client-secret"
gmail_oauth_redirect_uri  = "https://therapy-docs-web-prod-xxxxxxxxxx-uc.a.run.app/api-proxy/gmail/callback"

iap_accessor_members = ["group:therapists@example-clinic.com"]

api_url = "https://therapy-docs-api-prod-xxxxxxxxxx-uc.a.run.app"
