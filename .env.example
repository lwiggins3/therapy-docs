# Copy to .env and fill in for local development.
# In deployed environments, these are injected via Secret Manager / Cloud Run env vars — never committed.

# --- GCP project ---
GCP_PROJECT_ID=
GCP_REGION=us-central1

# --- Cloud SQL (Postgres + pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/therapy_docs

# --- Cloud Storage ---
GCS_DOCUMENTS_BUCKET=
GCS_TRANSCRIPTS_BUCKET=
STORAGE_PROVIDER=local # or "gcs" — see packages/storage
# Must be an ABSOLUTE path: apps/api and apps/worker run from different directories, and a
# relative path would resolve against each process's own cwd — i.e. two different folders,
# so the worker could never find files the API wrote. e.g. /Users/you/therapy_docs/.local-storage
LOCAL_STORAGE_DIR=

# --- Vertex AI ---
VERTEX_AI_PROJECT=
# Independent of GCP_REGION above — Claude on Vertex AI Model Garden is served through the "us"
# multi-region (not a specific region like "us-central1"); check your own project's Model
# Garden page, this can change. Native Gemini models typically use a specific region instead.
VERTEX_AI_LOCATION=us-central1
# Defaults to gemini for now: Claude on Model Garden needs a project-specific model id/version
# below (its hardcoded default 404s if not enabled in your project) — check your own project's
# Model Garden page for what's actually deployed before switching this to "claude-vertex".
LLM_PROVIDER=gemini # or "claude-vertex"
# Model id/version, e.g. "claude-sonnet-5@20260101" (Model Garden) or "gemini-2.5-pro". Leave
# unset to use each adapter's own hardcoded default — set explicitly once you know what's
# actually available in your project.
LLM_MODEL=

# --- Text extraction (apps/worker) ---
TEXT_EXTRACTOR=plain # or "document-ai" — "plain" only works for .txt/.md locally
DOCUMENT_AI_PROCESSOR_ID= # only used when TEXT_EXTRACTOR=document-ai

# --- Pub/Sub ---
PUBSUB_TOPIC_DOCUMENT_INGEST=document-ingest
PUBSUB_TOPIC_TRANSCRIPT_INGEST=transcript-ingest
PUBSUB_EMULATOR_HOST=localhost:8085 # unset in prod — @google-cloud/pubsub auto-detects this
WORKER_PUSH_URL=http://host.docker.internal:8081 # where the pubsub emulator pushes messages

# --- Service ports (apps/api and apps/worker default to the same PORT — split so both can run together) ---
API_PORT=8080
WORKER_PORT=8081

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Identity (Google Workspace / Cloud Identity via IAP) ---
IAP_AUDIENCE=

# --- Gmail API (draft-only, per-therapist OAuth, gmail.compose scope) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# --- Audit log sink ---
BIGQUERY_AUDIT_DATASET=audit_logs
